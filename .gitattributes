# Normalize text files; keep binary files untouched.
* text=auto eol=lf

*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.jar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
