<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FleetPulse" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/fleet_background</item>
    </style>

    <style name="Theme.FleetPulse.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fleet_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.FleetPulse</item>
    </style>
</resources>
